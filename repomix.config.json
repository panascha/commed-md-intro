{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "topFilesLength": 10
  },
  "include": [
    "*.py",
    "scripts/**",
    "research/**/*.py",
    "Commed OS idea/**/*.md",
    "Commed OS idea/**/*.py",
    "topics/**/*.md",
    ".github/**",
    ".gitignore",
    "*_overview.txt"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.*",
      "**/*.geojson",
      "**/*.bak*",
      "**/cache/**",
      "**/__pycache__/**",
      "**/*.pdf",
      "**/*.xlsx",
      "**/*.zip",
      "**/*.png",
      "**/*.jpg",
      "data.json",
      "index.html",
      "intro-commed-md.html",
      "full.md",
      "converted/**",
      "MCQ/**"
    ]
  },
  "security": { "enableSecurityCheck": true }
}
